<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FrameViewAnalyzer.Core\FrameViewAnalyzer.Core.csproj" />
    <ProjectReference Include="..\FrameViewAnalyzer.Analytics\FrameViewAnalyzer.Analytics.csproj" />
    <ProjectReference Include="..\FrameViewAnalyzer.Infrastructure\FrameViewAnalyzer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regression tests drive the real interaction lifecycle through the
         internal gesture seams (Begin/Update/End range selection). -->
    <InternalsVisibleTo Include="FrameViewAnalyzer.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>assets\frameview-analyzer.ico</ApplicationIcon>
    <!-- ScottPlot.WPF transitively references SkiaSharp.Views.WPF, whose
         latest 3.x package targets .NET Framework only. The wrapper loads
         fine on modern .NET WPF (standard ScottPlot setup); suppress the
         compatibility warning just for this package line. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\frameview-analyzer.png" />
    <Resource Include="assets\frameview-analyzer.ico" />
  </ItemGroup>

</Project>
