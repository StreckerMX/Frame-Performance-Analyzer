<Application x:Class="FrameViewAnalyzer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FrameViewAnalyzer.App;component/Themes/Colors.xaml" />
                <ResourceDictionary Source="/FrameViewAnalyzer.App;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="/FrameViewAnalyzer.App;component/Themes/Buttons.xaml" />
                <ResourceDictionary Source="/FrameViewAnalyzer.App;component/Themes/Panels.xaml" />
                <!-- LightTheme.xaml is merged at runtime by ThemeService. -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
