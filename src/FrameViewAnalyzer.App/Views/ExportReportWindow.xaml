<Window x:Class="FrameViewAnalyzer.App.Views.ExportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export PNG report"
        Width="520"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Report content"
                   FontSize="{DynamicResource FontSize.Title}"
                   FontWeight="Bold" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <RadioButton x:Name="AllRadio"
                         Content="Export all sessions"
                         GroupName="ExportScope"
                         IsChecked="True"
                         Style="{StaticResource SegmentedRadioStyle}" />
            <RadioButton x:Name="SingleRadio"
                         Content="Export selected session"
                         GroupName="ExportScope"
                         Margin="0,8,0,0"
                         Style="{StaticResource SegmentedRadioStyle}" />
            <ComboBox x:Name="SessionOptions"
                      Margin="20,8,0,0"
                      DisplayMemberPath="Label"
                      SelectionChanged="SessionOptions_SelectionChanged"
                      Style="{StaticResource DarkComboBoxStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="The report contains one chart per selected metric with the Base and Comparison series overlaid."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSize.Tiny}"
                   Foreground="{DynamicResource MutedBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Export"
                    x:Name="ExportButton"
                    Margin="8,0,0,0"
                    Click="Export_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
