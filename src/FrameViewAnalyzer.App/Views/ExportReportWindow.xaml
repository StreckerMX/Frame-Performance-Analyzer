<Window x:Class="FrameViewAnalyzer.App.Views.ExportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export PNG report"
        Width="680"
        Height="620"
        MinWidth="540"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Report content"
                       FontSize="{DynamicResource FontSize.Title}"
                       FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0"
                       Text="Choose the benchmarks and metrics to include. FPS is selected by default."
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Tiny}"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="REPORT TITLE"
                       FontSize="{DynamicResource FontSize.Small}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSoftBrush}" />
            <TextBox x:Name="ReportTitleTextBox"
                     Margin="0,6,0,0"
                     MaxLength="160"
                     Style="{StaticResource MetadataFieldStyle}"
                     ToolTip="Text shown at the top of the exported PNG" />
            <TextBlock Margin="0,4,0,0"
                       Text="Edit this text to choose exactly what appears at the top of the PNG."
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Tiny}"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BENCHMARKS"
                               FontSize="{DynamicResource FontSize.Small}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SessionChecklist">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="Selection_CheckedChanged"
                                              Unchecked="Selection_CheckedChanged"
                                              Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding ColorHex}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMultiPeer}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="METRICS"
                               FontSize="{DynamicResource FontSize.Small}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MetricChecklist">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="Selection_CheckedChanged"
                                              Unchecked="Selection_CheckedChanged"
                                              Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="SelectionStatus"
                   Margin="0,12,0,0"
                   FontSize="{DynamicResource FontSize.Tiny}"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Export"
                    x:Name="ExportButton"
                    Margin="8,0,0,0"
                    Click="Export_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
