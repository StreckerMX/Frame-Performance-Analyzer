<Window x:Class="FrameViewAnalyzer.App.Views.ExportReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export PNG report"
        Width="680"
        Height="560"
        MinWidth="540"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Report content"
                       FontSize="{DynamicResource FontSize.Title}"
                       FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0"
                       Text="Choose the benchmarks and metrics to include. FPS is selected by default."
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Tiny}"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BENCHMARKS"
                               FontSize="{DynamicResource FontSize.Small}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SessionChecklist">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="Selection_CheckedChanged"
                                              Unchecked="Selection_CheckedChanged"
                                              Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="METRICS"
                               FontSize="{DynamicResource FontSize.Small}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSoftBrush}" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MetricChecklist">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="Selection_CheckedChanged"
                                              Unchecked="Selection_CheckedChanged"
                                              Margin="0,0,0,8"
                                              Foreground="{DynamicResource TextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="SelectionStatus"
                   Margin="0,12,0,0"
                   FontSize="{DynamicResource FontSize.Tiny}"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Export"
                    x:Name="ExportButton"
                    Margin="8,0,0,0"
                    Click="Export_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
