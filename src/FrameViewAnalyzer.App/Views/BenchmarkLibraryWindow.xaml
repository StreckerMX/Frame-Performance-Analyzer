<Window x:Class="FrameViewAnalyzer.App.Views.BenchmarkLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FrameViewAnalyzer.App.Converters"
        Title="Benchmark Library"
        Width="980"
        Height="680"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="ContextPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComparisonSelectionMode}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SeriesBBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsComparisonSelectionMode}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SeriesBHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BenchmarkRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsComparisonSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SeriesBDimBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SeriesBBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Selectable}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                    <Setter Property="Opacity" Value="0.58" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectionIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsComparisonSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SeriesBBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SeriesBBrush}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Selectable}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Shared Library + contextual selection header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderLabel}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabelStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsComparisonSelectionMode}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SeriesBBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding HeaderDescription}"
                       Margin="0,3,0,0"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource TextSoftBrush}"
                       TextWrapping="Wrap" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="12,9"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="SOURCE FOLDER"
                                   Margin="0,0,12,0"
                                   FontSize="{DynamicResource FontSize.Tiny}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CaptureFolder}"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Button Grid.Column="1"
                        Content="Capture folder"
                        Margin="8,0,0,0"
                        Click="ChooseCaptureFolder_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Style="{StaticResource GhostButtonStyle}" />
            </Grid>
        </StackPanel>

        <!-- Search / filters / sort -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MetadataFieldStyle}"
                     ToolTip="Search all record text" />
            <TextBlock Grid.Column="1"
                       Text="🔍"
                       Margin="-24,0,8,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedBrush}" />
            <ComboBox Grid.Column="2"
                      MinWidth="120"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding GameOptions}"
                      SelectedItem="{Binding SelectedGame}"
                      Style="{StaticResource DarkComboBoxStyle}" />
            <ComboBox Grid.Column="3"
                      MinWidth="120"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding ResolutionOptions}"
                      SelectedItem="{Binding SelectedResolution}"
                      Style="{StaticResource DarkComboBoxStyle}" />
            <ComboBox Grid.Column="4"
                      MinWidth="130"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding GpuOptions}"
                      SelectedItem="{Binding SelectedGpu}"
                      Style="{StaticResource DarkComboBoxStyle}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Tags" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSoftBrush}" VerticalAlignment="Center" />
                <TextBox Width="220"
                         Margin="8,0,0,0"
                         Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MetadataFieldStyle}"
                         ToolTip="Comma-separated tags" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sort" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSoftBrush}" VerticalAlignment="Center" />
                <RadioButton Content="Date"
                             Margin="8,0,0,0"
                             GroupName="Sort"
                             IsChecked="{Binding SortByDate}"
                             Style="{StaticResource SegmentedRadioStyle}" />
                <RadioButton Content="Name"
                             Margin="10,0,0,0"
                             GroupName="Sort"
                             IsChecked="{Binding SortByDate, Converter={StaticResource InverseBool}}"
                             Style="{StaticResource SegmentedRadioStyle}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{Binding CountText}"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Recent Pair comparisons -->
        <ItemsControl Grid.Row="3"
                      Margin="0,10,0,0"
                      ItemsSource="{Binding RecentPairs}"
                      Visibility="{Binding IsLibraryMode, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,8,0"
                            Command="{Binding DataContext.ComparePairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource GhostButtonStyle}">
                        <Button.Content>
                            <TextBlock>
                                <Run Text="{Binding TitleA}" /><Run Text="  vs  " /><Run Text="{Binding TitleB}" />
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Rows -->
        <ScrollViewer x:Name="BenchmarkRowsScrollViewer"
                      Grid.Row="4"
                      Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,2,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BenchmarkRowCardStyle}"
                                Focusable="{Binding Selectable}"
                                ToolTip="{Binding DataContext.SelectionToolTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                MouseLeftButtonUp="BenchmarkRow_MouseLeftButtonUp"
                                KeyDown="BenchmarkRow_KeyDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SelectionIndicatorStyle}">
                                    <Path Stroke="{DynamicResource WindowBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 3,8 L 6.5,11 L 13,4.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420" />
                                        <Border Margin="8,0,0,0"
                                                Padding="6,2"
                                                CornerRadius="8"
                                                Background="{DynamicResource DangerBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Available, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="MISSING"
                                                       FontSize="{DynamicResource FontSize.Tiny}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                        <Border Margin="8,0,0,0"
                                                Padding="6,2"
                                                CornerRadius="8"
                                                Background="{DynamicResource SeriesBDimBrush}"
                                                BorderBrush="{DynamicResource SeriesBBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrentBase, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="CURRENT BASE"
                                                       FontSize="{DynamicResource FontSize.Tiny}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SeriesBBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{DynamicResource FontSize.Small}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stamp}"
                                               FontSize="{DynamicResource FontSize.Tiny}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Button Content="Base"
                                            Command="{Binding DataContext.LoadBaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding Available}"
                                            Visibility="{Binding DataContext.ShowQuickPairActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="Comparison"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.LoadComparisonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding Available}"
                                            Visibility="{Binding DataContext.ShowQuickPairActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                    <Button Content="Remove"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.RequestRemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove from Library without deleting the source CSV"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectionSummary}"
                           FontSize="{DynamicResource FontSize.Small}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSoftBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding FooterHelpText}"
                           Margin="0,2,12,0"
                           FontSize="{DynamicResource FontSize.Tiny}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- Full management commands remain on the toolbar Library entry. -->
                <Button Content="Compare selected"
                        Margin="0,0,8,0"
                        Command="{Binding CompareSelectedCommand}"
                        IsEnabled="{Binding CanCompareSelectedNow}"
                        Visibility="{Binding ShowLibraryActions, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Export package"
                        Margin="0,0,8,0"
                        Click="ExportPackage_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding ShowLibraryActions, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Import package"
                        Margin="0,0,8,0"
                        Click="ImportPackage_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding ShowLibraryActions, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Import legacy data"
                        Margin="0,0,8,0"
                        Click="ImportLegacy_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Visibility="{Binding ShowLibraryActions, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        Click="Close_Click"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="{Binding PrimaryActionText}"
                        Command="{Binding ConfirmSelectionCommand}"
                        IsEnabled="{Binding CanConfirmSelectionNow}"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource ContextPrimaryButtonStyle}" />
                <Button Content="Close"
                        Click="Close_Click"
                        Visibility="{Binding ShowLibraryActions, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
