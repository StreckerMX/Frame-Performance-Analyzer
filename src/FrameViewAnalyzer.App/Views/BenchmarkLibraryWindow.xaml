<Window x:Class="FrameViewAnalyzer.App.Views.BenchmarkLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FrameViewAnalyzer.App.Converters"
        Title="Benchmark Library"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search / filters / sort -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MetadataFieldStyle}"
                     ToolTip="Search all record text" />
            <TextBlock Grid.Column="1"
                       Text="🔍"
                       Margin="-24,0,8,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedBrush}" />
            <ComboBox Grid.Column="2"
                      MinWidth="120"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding GameOptions}"
                      SelectedItem="{Binding SelectedGame}"
                      FontSize="{DynamicResource FontSize.Small}" />
            <ComboBox Grid.Column="3"
                      MinWidth="120"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding ResolutionOptions}"
                      SelectedItem="{Binding SelectedResolution}"
                      FontSize="{DynamicResource FontSize.Small}" />
            <ComboBox Grid.Column="4"
                      MinWidth="130"
                      Margin="8,0,0,0"
                      ItemsSource="{Binding GpuOptions}"
                      SelectedItem="{Binding SelectedGpu}"
                      FontSize="{DynamicResource FontSize.Small}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Tags" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSoftBrush}" VerticalAlignment="Center" />
                <TextBox Width="220"
                         Margin="8,0,0,0"
                         Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MetadataFieldStyle}"
                         ToolTip="Comma-separated tags" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sort" FontSize="{DynamicResource FontSize.Small}" FontWeight="Bold"
                           Foreground="{DynamicResource TextSoftBrush}" VerticalAlignment="Center" />
                <RadioButton Content="Date"
                             Margin="8,0,0,0"
                             GroupName="Sort"
                             IsChecked="{Binding SortByDate}"
                             Foreground="{DynamicResource TextSoftBrush}"
                             FontSize="{DynamicResource FontSize.Small}"
                             VerticalContentAlignment="Center" />
                <RadioButton Content="Name"
                             Margin="10,0,0,0"
                             GroupName="Sort"
                             IsChecked="{Binding SortByDate, Converter={StaticResource InverseBool}}"
                             Foreground="{DynamicResource TextSoftBrush}"
                             FontSize="{DynamicResource FontSize.Small}"
                             VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="{Binding CountText}"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <!-- Recent comparisons -->
        <ItemsControl Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding RecentPairs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,8,0"
                            Command="{Binding DataContext.ComparePairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource GhostButtonStyle}">
                        <Button.Content>
                            <TextBlock>
                                <Run Text="{Binding TitleA}" /><Run Text="  vs  " /><Run Text="{Binding TitleB}" />
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Rows -->
        <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420" />
                                        <Border Margin="8,0,0,0"
                                                Padding="6,2"
                                                CornerRadius="8"
                                                Background="{DynamicResource DangerBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding Available, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="MISSING"
                                                       FontSize="{DynamicResource FontSize.Tiny}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{DynamicResource FontSize.Small}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stamp}"
                                               FontSize="{DynamicResource FontSize.Tiny}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <Button Content="Base"
                                            Command="{Binding DataContext.LoadBaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding Available}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Content="Comparison"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.LoadComparisonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding Available}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                    <ToggleButton Content="A/B"
                                                  Margin="8,0,0,0"
                                                  Command="{Binding DataContext.ToggleAbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  IsChecked="{Binding IsAbSelected, Mode=OneWay}"
                                                  IsEnabled="{Binding Available}"
                                                  Style="{StaticResource ToggleButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <TextBlock Text="Pick one capture as Base and another as Comparison, or toggle A/B twice to compare."
                       FontSize="{DynamicResource FontSize.Tiny}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
