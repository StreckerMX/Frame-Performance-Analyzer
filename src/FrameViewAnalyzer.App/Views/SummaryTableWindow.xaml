<Window x:Class="FrameViewAnalyzer.App.Views.SummaryTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding SummaryText}"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid x:Name="SummaryGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="{DynamicResource PanelAltBrush}"
                      AlternatingRowBackground="{DynamicResource PanelBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      FontSize="{DynamicResource FontSize.Small}"
                      Sorting="SummaryGrid_Sorting" />
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Close"
                    IsCancel="True"
                    MinWidth="90"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
