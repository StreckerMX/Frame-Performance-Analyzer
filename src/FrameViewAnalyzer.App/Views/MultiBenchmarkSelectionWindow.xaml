<Window x:Class="FrameViewAnalyzer.App.Views.MultiBenchmarkSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select benchmarks"
        Width="900"
        Height="760"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MULTI BENCHMARK"
                       Style="{StaticResource SectionLabelStyle}" />
            <TextBlock Margin="0,6,0,0"
                       Text="Select 2–8 captures. Multi compares every selected benchmark equally; there is no Base or Reference."
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSize.Small}"
                       Foreground="{DynamicResource TextSoftBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12,9"
                Background="{DynamicResource PanelAltBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Text="SOURCE FOLDER"
                           FontSize="{DynamicResource FontSize.Tiny}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding CaptureFolder}"
                           ToolTip="{Binding CaptureFolder}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding SelectionSummary}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="Select all"
                    Click="SelectAll_Click"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Clear"
                    Click="Clear_Click"
                    Style="{StaticResource GhostButtonStyle}" />
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource DarkCheckBoxStyle}" />
                                    <Grid Grid.Column="1" Margin="10,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Display}"
                                                       FontSize="{DynamicResource FontSize.Medium}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="14,0,0,0"
                                                       Text="{Binding CaptureTimeText}"
                                                       FontSize="{DynamicResource FontSize.Tiny}"
                                                       Foreground="{DynamicResource TextSoftBrush}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding TechnicalLine}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSize.Small}"
                                                   Foreground="{DynamicResource TextBrush}" />

                                        <TextBlock Grid.Row="2"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding HardwareLine}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSize.Tiny}"
                                                   Foreground="{DynamicResource TextSoftBrush}" />

                                        <TextBlock Grid.Row="3"
                                                   Margin="0,3,0,0"
                                                   Text="{Binding FileName}"
                                                   ToolTip="{Binding Path}"
                                                   FontSize="{DynamicResource FontSize.Tiny}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding ValidationText}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Load selected"
                    Click="LoadSelected_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
