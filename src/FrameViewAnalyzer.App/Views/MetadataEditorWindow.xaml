<Window x:Class="FrameViewAnalyzer.App.Views.MetadataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="620"
        Height="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Optional context that FrameView cannot detect automatically. It is stored by the app and never written to the CSV capture."
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSize.Small}"
                   Foreground="{DynamicResource MutedBrush}" />

        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Benchmark name" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding BenchmarkName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Game / scene" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding Game, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Resolution label" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Graphics preset" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding GraphicsPreset, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Upscaler" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding Upscaler, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Upscaler quality mode" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding UpscalerQuality, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Frame Generation" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding FrameGeneration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Ray Tracing / Path Tracing" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding RayTracing, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Driver version" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding DriverVersion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Tags (comma-separated)" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataFieldStyle}" />

                <TextBlock Text="Notes" Style="{StaticResource MetadataFieldLabelStyle}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MetadataFieldStyle}"
                         Height="90"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Save updates the cards and exports immediately."
                       FontSize="{DynamicResource FontSize.Tiny}"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
