<Window x:Class="FrameViewAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FrameViewAnalyzer.App.Views"
        xmlns:converters="clr-namespace:FrameViewAnalyzer.App.Converters"
        Title="FrameView Analyzer"
        Width="1380"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Upper dashboard -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FrameView Analyzer"
                                   FontSize="{DynamicResource FontSize.PageTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Analyze and compare NVIDIA performance captures"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Library"
                            Margin="0,0,8,0"
                            Click="Library_Click"
                            Style="{StaticResource GhostButtonStyle}" />
                    <Button Grid.Column="2"
                            Content="Export"
                            views:DropdownMenu.OpenOnLeftClick="True"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource DarkContextMenuStyle}">
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}" />
                                </ContextMenu.Resources>
                                <MenuItem Header="PNG report" Command="{Binding ExportPngReportCommand}" />
                                <MenuItem Header="Statistics CSV" Command="{Binding ExportStatisticsCsvCommand}" />
                                <MenuItem Header="Benchmark JSON" Command="{Binding ExportBenchmarkJsonCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Capture folder -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Capture folder"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSoftBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CaptureDirectory}"
                                   Margin="12,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="Choose folder"
                                Command="{Binding ChooseCaptureDirectoryCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </Grid>
                </Border>

                <!-- Session cards -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Base card -->
                    <Border Grid.Column="0" Style="{StaticResource SessionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="BASE LOG"
                                       FontSize="{DynamicResource FontSize.Tiny}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SeriesABrush}" />
                            <TextBlock Text="{Binding BaseSessionName}"
                                       FontSize="{DynamicResource FontSize.Title}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BaseMetaLine}"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{Binding BaseLoadButtonText}"
                                        Command="{Binding LoadBaseCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Content="Metadata"
                                        Margin="8,0,0,0"
                                        Command="{Binding EditBaseMetadataCommand}"
                                        IsEnabled="{Binding HasBase}"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="View details"
                                        Margin="8,0,0,0"
                                        Click="BaseDetails_Click"
                                        IsEnabled="{Binding HasBase}"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="Remove"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveBaseCommand}"
                                        Style="{StaticResource DangerGhostButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Width="46"
                            Height="46"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="23">
                        <TextBlock Text="VS"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSize.Tiny}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Border>

                    <!-- Comparison card -->
                    <Border Grid.Column="2" Style="{StaticResource SessionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="COMPARISON LOG"
                                       FontSize="{DynamicResource FontSize.Tiny}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SeriesBBrush}" />
                            <TextBlock Text="{Binding ComparisonSessionName}"
                                       FontSize="{DynamicResource FontSize.Title}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ComparisonMetaLine}"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ComparisonDeltaLine}"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SeriesBBrush}"
                                       Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{Binding ComparisonLoadButtonText}"
                                        Command="{Binding LoadComparisonCommand}"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="Metadata"
                                        Margin="8,0,0,0"
                                        Command="{Binding EditComparisonMetadataCommand}"
                                        IsEnabled="{Binding HasComparison}"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="View details"
                                        Margin="8,0,0,0"
                                        Click="ComparisonDetails_Click"
                                        IsEnabled="{Binding HasComparison}"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button Content="Remove"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveComparisonCommand}"
                                        Style="{StaticResource DangerGhostButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Metric-aware visible-range statistics strip. The number
                     of tiles follows the selected metric's useful statistic
                     fields, with VISIBLE TIME always retained. -->
                <Border Grid.Row="3"
                        Style="{StaticResource CardStyle}"
                        Padding="14,10">
                    <ItemsControl ItemsSource="{Binding Chart.KpiTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="{DynamicResource FontSize.Tiny}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="{DynamicResource FontSize.KpiValue}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DeltaText}" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Improvement">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Regression">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Analysis rail (upper-right of the dashboard) -->
            <ScrollViewer Grid.Column="1"
                          Width="300"
                          Margin="16,0,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="ANALYSIS RANGE" Style="{StaticResource SectionLabelStyle}" />
                            <CheckBox Margin="0,10,0,0"
                                      Content="Automatic (full session)"
                                      IsChecked="{Binding AnalysisRange.AutoGpuThresholdEnabled}"
                                      IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                      Style="{StaticResource DarkCheckBoxStyle}" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding AnalysisRange.GpuThresholdLabel}"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource TextSoftBrush}" />
                            <Slider Minimum="0"
                                    Maximum="80"
                                    Value="{Binding AnalysisRange.GpuThreshold, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding AnalysisRange.ManualGpuThresholdEnabled}"
                                    IsSnapToTickEnabled="False"
                                    TickFrequency="1"
                                    Style="{StaticResource DarkSliderStyle}" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding AnalysisRange.TrimLabel}"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource TextSoftBrush}" />
                            <Slider Minimum="0"
                                    Maximum="10"
                                    Value="{Binding AnalysisRange.TrimBufferSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                    TickFrequency="0.5"
                                    Style="{StaticResource DarkSliderStyle}" />
                            <CheckBox Margin="0,10,0,0"
                                      Content="Exclude loading screens / FPS cullers"
                                      IsChecked="{Binding AnalysisRange.ExcludeTransitionsEnabled}"
                                      IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                      Style="{StaticResource DarkCheckBoxStyle}" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding AnalysisRange.FilterHelpText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <Border Margin="0,12,0,0"
                                    Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <TextBlock Text="{Binding AnalysisRange.AnalysisSummaryText}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize.Small}"
                                           Foreground="{DynamicResource TextSoftBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Chart toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      x:Name="MetricSelector"
                      MinWidth="220"
                      ItemsSource="{Binding Chart.Metrics}"
                      SelectedItem="{Binding Chart.SelectedMetric}"
                      DisplayMemberPath="Label"
                      PreviewMouseWheel="MetricSelector_PreviewMouseWheel"
                      Style="{StaticResource DarkComboBoxStyle}" />
            <ToggleButton Grid.Column="1"
                          Margin="10,0,0,0"
                          Content="Data points"
                          IsChecked="{Binding Chart.MarkersVisible}"
                          Style="{StaticResource ToggleButtonStyle}" />
            <ToggleButton Grid.Column="2"
                          Margin="8,0,0,0"
                          Content="Wheel zoom"
                          IsChecked="{Binding Chart.WheelZoomEnabled}"
                          Style="{StaticResource ToggleButtonStyle}" />
            <ToggleButton Grid.Column="3"
                          Margin="8,0,0,0"
                          Content="Drag pan"
                          ToolTip="Turn off Drag pan to drag-select a time range."
                          IsChecked="{Binding Chart.PanEnabled}"
                          Style="{StaticResource ToggleButtonStyle}" />
            <Button Grid.Column="5"
                    Content="Analyze"
                    views:DropdownMenu.OpenOnLeftClick="True"
                    Style="{StaticResource GhostButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource DarkContextMenuStyle}">
                        <ContextMenu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}" />
                        </ContextMenu.Resources>
                        <MenuItem Header="Full capture" Command="{Binding AnalyzeFullCaptureCommand}" />
                        <MenuItem Header="Worst performance region (10 s)" Command="{Binding AnalyzeWorstRegionCommand}" />
                        <MenuItem Header="Most stable region (10 s)" Command="{Binding AnalyzeStableRegionCommand}" />
                        <MenuItem Header="Largest performance drop" Command="{Binding AnalyzeLargestDropCommand}" />
                        <MenuItem Header="Largest A/B difference"
                                  Command="{Binding AnalyzeLargestAbDifferenceCommand}"
                                  IsEnabled="{Binding HasComparison}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Column="6"
                    Margin="8,0,0,0"
                    Content="Reset zoom"
                    Click="ResetZoom_Click"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Grid.Column="7"
                    Margin="8,0,0,0"
                    Content="Auto zoom"
                    Click="AutoZoom_Click"
                    Style="{StaticResource GhostButtonStyle}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
            <views:SessionChartView x:Name="ChartView" />
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSoftBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
            <TextBlock Text="{Binding VersionText}"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
        </Grid>
    </Grid>
</Window>
