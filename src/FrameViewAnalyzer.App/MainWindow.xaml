<Window x:Class="FrameViewAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameView Analyzer"
        Width="1200"
        Height="800"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Identity header -->
        <Grid Grid.Row="0" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.png"
                   Width="30"
                   Height="30"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FrameView Analyzer"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Border Background="{DynamicResource AccentDimBrush}"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="NVIDIA FRAMEVIEW"
                                   FontSize="{DynamicResource FontSize.Tiny}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="NVIDIA FrameView session analysis and benchmarking."
                           FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Theme selector -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Dark"
                             GroupName="Theme"
                             IsChecked="{Binding IsDark, Mode=TwoWay}"
                             Foreground="{DynamicResource TextSoftBrush}"
                             FontSize="{DynamicResource FontSize.Small}"
                             VerticalContentAlignment="Center" />
                <RadioButton Content="Light"
                             GroupName="Theme"
                             Margin="10,0,0,0"
                             IsChecked="{Binding IsLight, Mode=TwoWay}"
                             Foreground="{DynamicResource TextSoftBrush}"
                             FontSize="{DynamicResource FontSize.Small}"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main content area (chart arrives in Phase 5) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <TextBlock Text="Load a FrameView CSV to view the analysis"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource FontSize.Body}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSoftBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
            <TextBlock Text="{Binding VersionText}"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
        </Grid>

    </Grid>
</Window>
