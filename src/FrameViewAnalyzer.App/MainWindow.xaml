<Window x:Class="FrameViewAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FrameViewAnalyzer.App.Views"
        Title="FrameView Analyzer"
        Width="1200"
        Height="800"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadBaseCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding LoadComparisonCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportPngReportCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportStatisticsCsvCommand}" />
    </Window.InputBindings>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main content column -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Identity header -->
            <Grid Grid.Row="0" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.png"
                   Width="30"
                   Height="30"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FrameView Analyzer"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <Border Background="{DynamicResource AccentDimBrush}"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="NVIDIA FRAMEVIEW"
                                   FontSize="{DynamicResource FontSize.Tiny}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="NVIDIA FrameView session analysis and benchmarking."
                           FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Theme selector + Library + Export -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Export ▾"
                        Margin="0,0,12,0"
                        Style="{StaticResource GhostButtonStyle}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="PNG report" Click="ExportPng_Click" />
                            <MenuItem Header="Statistics CSV" Click="ExportCsv_Click" />
                            <MenuItem Header="Benchmark data JSON" Click="ExportJson_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Library"
                        Margin="0,0,12,0"
                        Click="Library_Click"
                        Style="{StaticResource GhostButtonStyle}" />
                <RadioButton Content="Dark"
                             GroupName="Theme"
                             IsChecked="{Binding IsDark, Mode=TwoWay}"
                             Foreground="{DynamicResource TextSoftBrush}"
                             FontSize="{DynamicResource FontSize.Small}"
                             VerticalContentAlignment="Center" />
                <RadioButton Content="Light"
                             GroupName="Theme"
                             Margin="10,0,0,0"
                             IsChecked="{Binding IsLight, Mode=TwoWay}"
                             Foreground="{DynamicResource TextSoftBrush}"
                             FontSize="{DynamicResource FontSize.Small}"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Capture bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Capture folder ▾"
                    Style="{StaticResource GhostButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding CaptureFolderPath}"
                                  IsEnabled="False"
                                  FontWeight="Bold" />
                        <Separator />
                        <MenuItem Header="Choose default folder..."
                                  Command="{Binding ChooseCaptureFolderCommand}" />
                        <MenuItem Header="Reset to FrameView folder"
                                  Command="{Binding ResetCaptureFolderCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      ItemsSource="{Binding Captures}"
                      SelectedItem="{Binding SelectedCapture}"
                      DisplayMemberPath="Display"
                      ToolTip="Quick-open a capture from the default folder"
                      FontSize="{DynamicResource FontSize.Body}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="↻"
                    ToolTip="Refresh captures"
                    Command="{Binding RefreshCapturesCommand}"
                    Style="{StaticResource GhostButtonStyle}" />
        </Grid>

        <!-- Base / Comparison session band -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Base card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="BASE LOG"
                               FontSize="{DynamicResource FontSize.Tiny}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding BaseSessionName}"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BaseMetaLine}"
                               FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding BaseLoadButtonText}"
                                Command="{Binding LoadBaseCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Metadata"
                                Margin="8,0,0,0"
                                Command="{Binding EditBaseMetadataCommand}"
                                IsEnabled="{Binding HasBaseSession}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="View details"
                                Margin="8,0,0,0"
                                Click="BaseDetails_Click"
                                IsEnabled="{Binding HasBaseSession}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Remove"
                                Margin="8,0,0,0"
                                Command="{Binding RemoveBaseCommand}"
                                Style="{StaticResource DangerGhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- VS badge -->
            <Border Grid.Column="1"
                    Width="44"
                    Height="44"
                    Margin="12,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PanelAltBrush}"
                    CornerRadius="22">
                <TextBlock Text="VS"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Tiny}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" />
            </Border>

            <!-- Comparison card -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="COMPARISON LOG"
                               FontSize="{DynamicResource FontSize.Tiny}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SeriesBBrush}" />
                    <TextBlock Text="{Binding ComparisonSessionName}"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ComparisonMetaLine}"
                               FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ComparisonDeltaLine}"
                               FontSize="{DynamicResource FontSize.Small}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SeriesBBrush}"
                               Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding ComparisonLoadButtonText}"
                                Command="{Binding LoadComparisonCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Metadata"
                                Margin="8,0,0,0"
                                Command="{Binding EditComparisonMetadataCommand}"
                                IsEnabled="{Binding HasComparison}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="View details"
                                Margin="8,0,0,0"
                                Click="ComparisonDetails_Click"
                                IsEnabled="{Binding HasComparison}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Remove"
                                Margin="8,0,0,0"
                                Command="{Binding RemoveComparisonCommand}"
                                Style="{StaticResource DangerGhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Chart card -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Visible-range statistics strip -->
            <Border Grid.Row="0"
                    Margin="0,0,0,8"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <ItemsControl ItemsSource="{Binding Chart.KpiTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="{DynamicResource FontSize.Tiny}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="{DynamicResource FontSize.KpiValue}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DeltaText}" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Improvement">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Regression">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Chart toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          x:Name="MetricSelector"
                          MinWidth="220"
                          ItemsSource="{Binding Chart.Metrics}"
                          SelectedItem="{Binding Chart.SelectedMetric}"
                          DisplayMemberPath="Label"
                          PreviewMouseWheel="MetricSelector_PreviewMouseWheel"
                          FontSize="{DynamicResource FontSize.Body}" />
                <ToggleButton Grid.Column="1"
                              Margin="10,0,0,0"
                              Content="Data points"
                              IsChecked="{Binding Chart.MarkersVisible}"
                              Style="{StaticResource ToggleButtonStyle}" />
                <ToggleButton Grid.Column="2"
                              Margin="8,0,0,0"
                              Content="Wheel zoom"
                              IsChecked="{Binding Chart.WheelZoomEnabled}"
                              Style="{StaticResource ToggleButtonStyle}" />
                <ToggleButton Grid.Column="3"
                              Margin="8,0,0,0"
                              Content="Drag pan"
                              IsChecked="{Binding Chart.PanEnabled}"
                              Style="{StaticResource ToggleButtonStyle}" />
                <Button Grid.Column="5"
                        Content="Analyze ▾"
                        Style="{StaticResource GhostButtonStyle}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Full capture" Command="{Binding AnalyzeFullCaptureCommand}" />
                            <MenuItem Header="Worst performance region (10 s)" Command="{Binding AnalyzeWorstRegionCommand}" />
                            <MenuItem Header="Most stable region (10 s)" Command="{Binding AnalyzeStableRegionCommand}" />
                            <MenuItem Header="Largest performance drop" Command="{Binding AnalyzeLargestDropCommand}" />
                            <MenuItem Header="Largest A/B difference"
                                      Command="{Binding AnalyzeLargestAbDifferenceCommand}"
                                      IsEnabled="{Binding HasComparison}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="6"
                        Margin="8,0,0,0"
                        Content="Reset zoom"
                        Click="ResetZoom_Click"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Grid.Column="7"
                        Margin="8,0,0,0"
                        Content="Auto zoom"
                        Click="AutoZoom_Click"
                        Style="{StaticResource GhostButtonStyle}" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <views:SessionChartView x:Name="ChartView" Margin="10" />
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSoftBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
            <TextBlock Text="{Binding VersionText}"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
        </Grid>
        </Grid>

        <!-- Analysis rail -->
        <ScrollViewer Grid.Column="1"
                      Width="300"
                      Margin="14,14,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="ANALYSIS RANGE"
                                   FontSize="{DynamicResource FontSize.Tiny}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="Automatically set (full session)"
                                  IsChecked="{Binding AnalysisRange.AutoGpuThresholdEnabled}"
                                  IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                  FontSize="{DynamicResource FontSize.Small}"
                                  Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding AnalysisRange.GpuThresholdLabel}"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource TextSoftBrush}" />
                        <Slider Minimum="0"
                                Maximum="80"
                                Value="{Binding AnalysisRange.GpuThreshold, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding AnalysisRange.ManualGpuThresholdEnabled}"
                                IsSnapToTickEnabled="False"
                                TickFrequency="1" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding AnalysisRange.TrimLabel}"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource TextSoftBrush}" />
                        <Slider Minimum="0"
                                Maximum="10"
                                Value="{Binding AnalysisRange.TrimBufferSeconds, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                TickFrequency="0.5" />
                        <CheckBox Margin="0,8,0,0"
                                  Content="Exclude loading screens / FPS cullers"
                                  IsChecked="{Binding AnalysisRange.ExcludeTransitionsEnabled}"
                                  IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                  FontSize="{DynamicResource FontSize.Small}"
                                  Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding AnalysisRange.FilterHelpText}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <Border Margin="0,10,0,0"
                                Background="{DynamicResource PanelAltBrush}"
                                CornerRadius="8"
                                Padding="10,8">
                            <TextBlock Text="{Binding AnalysisRange.AnalysisSummaryText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource TextSoftBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
