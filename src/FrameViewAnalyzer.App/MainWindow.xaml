<Window x:Class="FrameViewAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FrameViewAnalyzer.App.Views"
        Title="FrameView Analyzer"
        Width="1600"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontFamily.App}"
        Icon="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.ico">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadBaseCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding LoadComparisonCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportPngReportCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportStatisticsCsvCommand}" />
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main content column -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Identity header -->
            <Grid Grid.Row="0" Margin="0,2,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/FrameViewAnalyzer.App;component/assets/frameview-analyzer.png"
                       Width="34"
                       Height="34"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FrameView Analyzer"
                                   FontSize="{DynamicResource FontSize.Title}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Border Background="{DynamicResource AccentDimBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="NVIDIA FRAMEVIEW"
                                       FontSize="{DynamicResource FontSize.Tiny}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="NVIDIA FrameView session analysis and benchmarking."
                               FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Toolbar: capture folder, session selector, exports, theme. -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Capture folder"
                        views:DropdownMenu.OpenOnLeftClick="True"
                        Style="{StaticResource GhostButtonStyle}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource DarkContextMenuStyle}">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}" />
                                <Style TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparatorStyle}" />
                            </ContextMenu.Resources>
                            <MenuItem Header="{Binding CaptureFolderPath}"
                                      IsEnabled="False"
                                      FontWeight="Bold" />
                            <Separator />
                            <MenuItem Header="Choose default folder..."
                                      Command="{Binding ChooseCaptureFolderCommand}" />
                            <MenuItem Header="Reset to FrameView folder"
                                      Command="{Binding ResetCaptureFolderCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ComboBox Grid.Column="1"
                          Margin="8,0,0,0"
                          ItemsSource="{Binding Captures}"
                          SelectedItem="{Binding SelectedCapture}"
                          DisplayMemberPath="Display"
                          ToolTip="Quick-open a capture from the default folder"
                          Style="{StaticResource DarkComboBoxStyle}" />
                <Button Grid.Column="2"
                        Margin="6,0,0,0"
                        Content="↻"
                        ToolTip="Refresh captures"
                        Command="{Binding RefreshCapturesCommand}"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Grid.Column="3"
                        Margin="14,0,0,0"
                        Content="Export"
                        views:DropdownMenu.OpenOnLeftClick="True"
                        Style="{StaticResource GhostButtonStyle}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource DarkContextMenuStyle}">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}" />
                            </ContextMenu.Resources>
                            <MenuItem Header="PNG report" Click="ExportPng_Click" />
                            <MenuItem Header="Statistics CSV" Click="ExportCsv_Click" />
                            <MenuItem Header="Benchmark data JSON" Click="ExportJson_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="4"
                        Margin="8,0,0,0"
                        Content="Library"
                        Click="Library_Click"
                        Style="{StaticResource GhostButtonStyle}" />
                <Border Grid.Column="5"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SegmentedTrackStyle}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Dark"
                                     GroupName="Theme"
                                     IsChecked="{Binding IsDark, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioStyle}" />
                        <RadioButton Content="Light"
                                     GroupName="Theme"
                                     IsChecked="{Binding IsLight, Mode=TwoWay}"
                                     Style="{StaticResource SegmentedRadioStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

        <!-- Base / Comparison session band -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Base card -->
            <Border Grid.Column="0" Style="{StaticResource SessionCardStyle}">
                <StackPanel>
                    <TextBlock Text="BASE LOG" Style="{StaticResource SectionLabelStyle}" />
                    <TextBlock Text="{Binding BaseSessionName}"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BaseMetaLine}"
                               FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding BaseLoadButtonText}"
                                Command="{Binding LoadBaseCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Metadata"
                                Margin="8,0,0,0"
                                Command="{Binding EditBaseMetadataCommand}"
                                IsEnabled="{Binding HasBaseSession}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="View details"
                                Margin="8,0,0,0"
                                Click="BaseDetails_Click"
                                IsEnabled="{Binding HasBaseSession}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Remove"
                                Margin="8,0,0,0"
                                Command="{Binding RemoveBaseCommand}"
                                Style="{StaticResource DangerGhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- VS badge -->
            <Border Grid.Column="1"
                    Width="46"
                    Height="46"
                    Margin="14,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="23">
                <TextBlock Text="VS"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Tiny}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" />
            </Border>

            <!-- Comparison card -->
            <Border Grid.Column="2" Style="{StaticResource SessionCardStyle}">
                <StackPanel>
                    <TextBlock Text="COMPARISON LOG"
                               FontSize="{DynamicResource FontSize.Tiny}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SeriesBBrush}" />
                    <TextBlock Text="{Binding ComparisonSessionName}"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ComparisonMetaLine}"
                               FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ComparisonDeltaLine}"
                               FontSize="{DynamicResource FontSize.Small}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SeriesBBrush}"
                               Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding ComparisonLoadButtonText}"
                                Command="{Binding LoadComparisonCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Metadata"
                                Margin="8,0,0,0"
                                Command="{Binding EditComparisonMetadataCommand}"
                                IsEnabled="{Binding HasComparison}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="View details"
                                Margin="8,0,0,0"
                                Click="ComparisonDetails_Click"
                                IsEnabled="{Binding HasComparison}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="Remove"
                                Margin="8,0,0,0"
                                Command="{Binding RemoveComparisonCommand}"
                                Style="{StaticResource DangerGhostButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Chart card -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Visible-range statistics strip -->
            <Border Grid.Row="0"
                    Margin="0,0,0,10"
                    Style="{StaticResource CardStyle}"
                    Padding="14,10">
                <ItemsControl ItemsSource="{Binding Chart.KpiTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="{DynamicResource FontSize.Tiny}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding Value}"
                                           FontSize="{DynamicResource FontSize.KpiValue}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DeltaText}" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Improvement">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Regression">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Chart toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          x:Name="MetricSelector"
                          MinWidth="220"
                          ItemsSource="{Binding Chart.Metrics}"
                          SelectedItem="{Binding Chart.SelectedMetric}"
                          DisplayMemberPath="Label"
                          PreviewMouseWheel="MetricSelector_PreviewMouseWheel"
                          Style="{StaticResource DarkComboBoxStyle}" />
                <ToggleButton Grid.Column="1"
                              Margin="10,0,0,0"
                              Content="Data points"
                              IsChecked="{Binding Chart.MarkersVisible}"
                              Style="{StaticResource ToggleButtonStyle}" />
                <ToggleButton Grid.Column="2"
                              Margin="8,0,0,0"
                              Content="Wheel zoom"
                              IsChecked="{Binding Chart.WheelZoomEnabled}"
                              Style="{StaticResource ToggleButtonStyle}" />
                <ToggleButton Grid.Column="3"
                              Margin="8,0,0,0"
                              Content="Drag pan"
                              ToolTip="Turn off Drag pan to drag-select a time range."
                              IsChecked="{Binding Chart.PanEnabled}"
                              Style="{StaticResource ToggleButtonStyle}" />
                <Button Grid.Column="5"
                        Content="Analyze"
                        views:DropdownMenu.OpenOnLeftClick="True"
                        Style="{StaticResource GhostButtonStyle}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource DarkContextMenuStyle}">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}" />
                            </ContextMenu.Resources>
                            <MenuItem Header="Full capture" Command="{Binding AnalyzeFullCaptureCommand}" />
                            <MenuItem Header="Worst performance region (10 s)" Command="{Binding AnalyzeWorstRegionCommand}" />
                            <MenuItem Header="Most stable region (10 s)" Command="{Binding AnalyzeStableRegionCommand}" />
                            <MenuItem Header="Largest performance drop" Command="{Binding AnalyzeLargestDropCommand}" />
                            <MenuItem Header="Largest A/B difference"
                                      Command="{Binding AnalyzeLargestAbDifferenceCommand}"
                                      IsEnabled="{Binding HasComparison}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="6"
                        Margin="8,0,0,0"
                        Content="Reset zoom"
                        Click="ResetZoom_Click"
                        Style="{StaticResource GhostButtonStyle}" />
                <Button Grid.Column="7"
                        Margin="8,0,0,0"
                        Content="Auto zoom"
                        Click="AutoZoom_Click"
                        Style="{StaticResource GhostButtonStyle}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
                <views:SessionChartView x:Name="ChartView" />
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSoftBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
            <TextBlock Text="{Binding VersionText}"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource FontSize.Small}" />
        </Grid>
        </Grid>

        <!-- Analysis rail -->
        <ScrollViewer Grid.Column="1"
                      Width="300"
                      Margin="16,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="ANALYSIS RANGE" Style="{StaticResource SectionLabelStyle}" />
                        <CheckBox Margin="0,10,0,0"
                                  Content="Automatic (full session)"
                                  IsChecked="{Binding AnalysisRange.AutoGpuThresholdEnabled}"
                                  IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                  Style="{StaticResource DarkCheckBoxStyle}" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding AnalysisRange.GpuThresholdLabel}"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource TextSoftBrush}" />
                        <Slider Minimum="0"
                                Maximum="80"
                                Value="{Binding AnalysisRange.GpuThreshold, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding AnalysisRange.ManualGpuThresholdEnabled}"
                                IsSnapToTickEnabled="False"
                                TickFrequency="1"
                                Style="{StaticResource DarkSliderStyle}" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding AnalysisRange.TrimLabel}"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource TextSoftBrush}" />
                        <Slider Minimum="0"
                                Maximum="10"
                                Value="{Binding AnalysisRange.TrimBufferSeconds, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                TickFrequency="0.5"
                                Style="{StaticResource DarkSliderStyle}" />
                        <CheckBox Margin="0,10,0,0"
                                  Content="Exclude loading screens / FPS cullers"
                                  IsChecked="{Binding AnalysisRange.ExcludeTransitionsEnabled}"
                                  IsEnabled="{Binding AnalysisRange.IsEnabled}"
                                  Style="{StaticResource DarkCheckBoxStyle}" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding AnalysisRange.FilterHelpText}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Small}"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <Border Margin="0,12,0,0"
                                Background="{DynamicResource PanelAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <TextBlock Text="{Binding AnalysisRange.AnalysisSummaryText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Small}"
                                       Foreground="{DynamicResource TextSoftBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
