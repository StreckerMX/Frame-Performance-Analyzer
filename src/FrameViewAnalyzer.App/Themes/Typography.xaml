<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="FontFamily.App">Segoe UI</FontFamily>
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Title">17</sys:Double>
    <sys:Double x:Key="FontSize.Section">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">11</sys:Double>
    <sys:Double x:Key="FontSize.Small">10</sys:Double>
    <sys:Double x:Key="FontSize.Tiny">9</sys:Double>
</ResourceDictionary>
