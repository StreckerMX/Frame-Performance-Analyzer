<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Central theme tokens. Dark values live here (the app default);
      LightTheme.xaml overrides the same keys and is merged on top when
      light mode is active. All views must reference these keys via
      DynamicResource so runtime switching works.
    -->
    <SolidColorBrush x:Key="WindowBrush" Color="#000000" />
    <SolidColorBrush x:Key="CardBrush" Color="#0C0C0C" />
    <SolidColorBrush x:Key="PanelBrush" Color="#101010" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#181818" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#C6C6C6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8E8E8E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#76B900" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8FD119" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#1B2E0C" />
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="GridBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#131313" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF6D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D05B5B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D9A530" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="SeriesABrush" Color="#76B900" />
    <SolidColorBrush x:Key="SeriesBBrush" Color="#4FA3D1" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1D2F0D" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#131313" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#333333" />
</ResourceDictionary>
