<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Central theme tokens. Dark values live here (the app default);
      LightTheme.xaml overrides the same keys and is merged on top when
      light mode is active. All views must reference these keys via
      DynamicResource so runtime switching works.
    -->
    <SolidColorBrush x:Key="WindowBrush" Color="#000000" />
    <SolidColorBrush x:Key="CardBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#161616" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#262626" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#262626" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#76B900" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8FD119" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#16240A" />
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#080808" />
    <SolidColorBrush x:Key="GridBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF6D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D05B5B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D9A530" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="SeriesABrush" Color="#76B900" />
    <SolidColorBrush x:Key="SeriesBBrush" Color="#4FA3D1" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1D2F0D" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#2E2E2E" />
</ResourceDictionary>
