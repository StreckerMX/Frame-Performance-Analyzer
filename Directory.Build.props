<Project>
  <!-- Shared build settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Stable Windows file metadata used by SignPath artifact restrictions. -->
    <Product>FrameView Analyzer</Product>
    <AssemblyTitle>FrameView Analyzer</AssemblyTitle>
    <Description>Native Windows benchmark analysis for NVIDIA FrameView captures and NVIDIA App performance logs.</Description>
    <Company>StreckerMX</Company>
    <Authors>StreckerMX</Authors>
    <Copyright>Copyright © StreckerMX</Copyright>

    <!-- Single source of truth for the product version:
         Version/InformationalVersion = 2.3.0 (UI, startup log, and packaging
         read this); AssemblyVersion/FileVersion stay numeric for Windows. -->
    <VersionPrefix>2.3.0</VersionPrefix>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
