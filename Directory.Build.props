<Project>
  <!-- Shared build settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Single source of truth for the product version (Phase 14):
         InformationalVersion = 2.0.0-rc.1 (UI, startup log, and packaging read
         this); AssemblyVersion/FileVersion stay numeric for Windows. The
         release-candidate suffix is dropped only by the final stable release. -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix>rc.1</VersionSuffix>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
